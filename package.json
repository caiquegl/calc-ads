{
  "name": "acerto",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "pnpm --filter @acerto/api dev",
    "dev:mobile": "pnpm --filter @acerto/mobile dev",
    "dev:web": "pnpm --filter @acerto/web dev",
    "build:web": "pnpm --filter @acerto/web build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "check": "turbo run typecheck test",
    "arte": "pnpm --filter @acerto/mobile arte"
  },
  "devDependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
